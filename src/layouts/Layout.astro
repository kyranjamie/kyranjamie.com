---
import '../styles/global.css'

interface Props {
  title?: string
}

const { title = '@kyranjamie' } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Personal website of frontend developer Kyran Burraston, @kyranjamie" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-container">
      <header><a href="/">kyranjamie.com</a></header>
      <main><slot /></main>
      <footer>
        <a href="https://github.com/kyranjamie">GitHub</a>
        <a href="https://stackoverflow.com/users/1141891/kyranjamie">Stack Overflow</a>
        <a href="https://www.linkedin.com/in/kyranjamie/">LinkedIn</a>
        <a href="https://twitter.com/kyranjamie">X</a>
      </footer>
    </div>
  </body>
</html>
