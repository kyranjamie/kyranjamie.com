---
import { Font } from 'astro:assets'

import '../styles/global.css'

interface Props {
  title?: string
}

const { title = 'Kyran Jamie — Software engineer' } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Personal website of software engineer Kyran Jamie, @kyranjamie"
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <Font cssVariable="--font-commit-mono" preload />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-container">
      <slot name="header" />
      <main><slot /></main>
      <footer class="link-list">
        <h2>Links</h2>
        <article>
          <h3>GitHub</h3>
          <a href="https://github.com/kyranjamie">github.com/kyranjamie</a>
        </article>
        <article>
          <h3>LinkedIn</h3>
          <a href="https://www.linkedin.com/in/kyranjamie/">linkedin.com/in/kyranjamie</a>
        </article>
        <article>
          <h3>Stack Overflow</h3>
          <a href="https://stackoverflow.com/users/1141891/kyranjamie">
            stackoverflow.com/users/1141891/kyranjamie
          </a>
        </article>
        <article>
          <h3>PGP public key</h3>
          <a href="/pgp.asc" target="_blank" rel="noopener noreferrer">kyranjamie.com/pgp.asc</a>
        </article>
      </footer>
    </div>
  </body>
</html>
