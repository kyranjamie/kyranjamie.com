---
import { Font } from 'astro:assets'

import '../styles/global.css'

interface Props {
  title?: string
}

const { title = 'Kyran Jamie — Software engineer' } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Personal website of software engineer Kyran Jamie, @kyranjamie"
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <Font cssVariable="--font-commit-mono" preload />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-container">
      <slot name="header" />
      <main><slot /></main>
      <footer class="link-list">
        <slot name="footer" />
      </footer>
    </div>
  </body>
</html>
