---
import { Content as Header } from '../content/home/header.md'
import { Content as Intro } from '../content/home/intro.md'
import { Content as Work, getHeadings } from '../content/home/work.md'
import { Content as Links } from '../content/home/links.md'
import Layout from '../layouts/Layout.astro'

const workHeading = getHeadings().find((heading) => heading.depth === 2)
---

<Layout>
  <header slot="header" class="intro-header">
    <Header />
  </header>
  <section class="intro">
    <Intro />
  </section>
  <section class="projects link-list" aria-labelledby={workHeading?.slug}>
    <Work />
  </section>
  <Links slot="footer" />
</Layout>
