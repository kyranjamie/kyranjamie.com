---
import Layout from '../layouts/Layout.astro'

const projects = [
  {
    title: 'Leather',
    url: 'https://leather.io',
    linkLabel: 'leather.io',
    description: 'Led the engineering team at Leather, a wallet for Bitcoin and Stacks',
  },
  {
    title: 'Blockport',
    url: 'https://web.archive.org/web/20191216074054/https://blockport.io/',
    linkLabel: 'blockport.io',
    description: 'Led the frontend team at Blockport, a cryptocurrency exchange start up',
  },
  {
    title: 'GoldRepublic',
    url: 'https://www.goldrepublic.com/en-gb',
    linkLabel: 'goldrepublic.com',
    description:
      'Modernised GoldRepublic’s platform for managing customers in its precious-metals trading business',
  },
  {
    title: 'Usabilla',
    url: 'https://web.archive.org/web/20181228015654/https://usabilla.com/',
    linkLabel: 'usabilla.com',
    description:
      'Rebuilt Usabilla’s product as a single-page application, replacing its legacy PHP-driven interface.',
  },
]
---

<Layout>
  <header class="intro-header">
    <h1><a href="/">Kyran Jamie</a></h1>
    <p>Software engineer</p>
  </header>
  <section class="intro">
    <p>I make complicated digital products feel simple.</p>
    <p>
      I’ve built and improved digital products for{' '}
      <a href="https://web.archive.org/web/20181228015654/https://usabilla.com/">Usabilla</a>,{' '}
      <a href="https://www.goldrepublic.com/">GoldRepublic</a>, and{' '}
      <a href="https://web.archive.org/web/20191216074054/https://blockport.io/">Blockport</a>. More
      recently, I helped build{' '}
      <a href="https://leather.io/">Leather</a>, a wallet for Bitcoin and Stacks.
    </p>
    <p>
      I care about accessible interfaces, fast applications, useful data visualisation, and code
      that remains understandable as a product evolves.
    </p>
  </section>
  <section class="projects" aria-labelledby="projects-heading">
    <h2 id="projects-heading">Selected work</h2>
    {
      projects.map((project) => (
        <article>
          <h3>{project.title}</h3>
          <a class="project-link" href={project.url}>
            {project.linkLabel ?? project.url}
          </a>
          <p>{project.description}</p>
        </article>
      ))
    }
  </section>
</Layout>
