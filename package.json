{
  "name": "kyranjamie.github.io",
  "description": "Personal website of @kyranjamie",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node ./scripts/require-devcontainer.mjs && astro build",
    "check": "node ./scripts/require-devcontainer.mjs && tsc --noEmit",
    "lint": "node ./scripts/require-devcontainer.mjs && eslint . --max-warnings 0",
    "lint:fix": "node ./scripts/require-devcontainer.mjs && eslint . --fix",
    "dev": "node ./scripts/require-devcontainer.mjs && astro dev",
    "deploy": "node ./scripts/require-devcontainer.mjs && pnpm build && wrangler deploy --env production",
    "deploy:preview": "node ./scripts/require-devcontainer.mjs && pnpm build && wrangler deploy",
    "preview": "node ./scripts/require-devcontainer.mjs && astro preview",
    "preview:worker": "node ./scripts/require-devcontainer.mjs && pnpm build && wrangler dev",
    "start": "node ./scripts/require-devcontainer.mjs && astro dev",
    "preinstall": "node ./scripts/require-devcontainer.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "astro": "7.3.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.0",
    "vite": "8.1.5",
    "wrangler": "4.129.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kyranjamie/kyranjamie.github.io"
  },
  "packageManager": "pnpm@11.16.0+sha512.b767e9a98fc87aec0f42daefcd0e84941c2cdb45d73c4e1e68860fb2bdfdbe032ab592105479e5e05c237f740c8a5ffdbbb52385797ddc2296745a1bbb883e8d"
}
