{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kyranjamie-com-preview",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "headers": {
      "Content-Security-Policy": "default-src 'self'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://assets.calibre.app; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; upgrade-insecure-requests"
    },
  },
  "env": {
    "production": {
      "name": "kyranjamie-com",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "kyranjamie.com", "custom_domain": true },
        { "pattern": "www.kyranjamie.com", "custom_domain": true },
      ],
    },
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
    },
  },
}
